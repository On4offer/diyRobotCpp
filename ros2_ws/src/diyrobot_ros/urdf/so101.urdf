<?xml version="1.0"?>
<robot name="so101">
  <material name="orange"><color rgba="0.95 0.45 0.08 1"/></material>
  <link name="base_link"><visual><geometry><cylinder radius="0.045" length="0.04"/></geometry><material name="orange"/></visual></link>
  <link name="shoulder_link"><visual><origin xyz="0 0 0.0888"/><geometry><box size="0.035 0.035 0.1776"/></geometry><material name="orange"/></visual></link>
  <joint name="shoulder_pan_joint" type="revolute"><parent link="base_link"/><child link="shoulder_link"/><origin xyz="0.0388 0 0.0624"/><axis xyz="0 0 1"/><limit lower="-2.0" upper="2.0" effort="20" velocity="2"/></joint>
  <link name="upper_arm_link"><visual><origin xyz="0 0 0.0675"/><geometry><box size="0.03 0.03 0.135"/></geometry><material name="orange"/></visual></link>
  <joint name="shoulder_lift_joint" type="revolute"><parent link="shoulder_link"/><child link="upper_arm_link"/><origin xyz="0 0 0.1776"/><axis xyz="0 1 0"/><limit lower="-2.0" upper="2.0" effort="20" velocity="2"/></joint>
  <link name="forearm_link"><visual><origin xyz="0 0 0.049"/><geometry><box size="0.025 0.025 0.098"/></geometry><material name="orange"/></visual></link>
  <joint name="elbow_flex_joint" type="revolute"><parent link="upper_arm_link"/><child link="forearm_link"/><origin xyz="0 0 0.135"/><axis xyz="0 1 0"/><limit lower="-2.4" upper="2.4" effort="20" velocity="2"/></joint>
  <link name="wrist_link"/><joint name="wrist_flex_joint" type="revolute"><parent link="forearm_link"/><child link="wrist_link"/><origin xyz="0 0 0.098"/><axis xyz="0 1 0"/><limit lower="-2.4" upper="2.4" effort="10" velocity="3"/></joint>
  <link name="tool0"/><joint name="wrist_roll_joint" type="continuous"><parent link="wrist_link"/><child link="tool0"/><axis xyz="0 0 1"/><limit effort="10" velocity="3"/></joint>
</robot>
