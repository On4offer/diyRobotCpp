[Unit]
Description=diyRobotCpp ROS 2 grasp stack
After=network.target

[Service]
Type=simple
User=robot
WorkingDirectory=/opt/diyrobot
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /opt/diyrobot/ros2_ws/install/setup.bash && ros2 launch diyrobot_ros diyrobot.launch.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
